      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runInitialized')) {",
          "  const runId = Date.now();",
          "  const petId = String(runId);",
          "  const orderId = String(runId).slice(-9);",
          "  const username = `qa_user_${runId}`;",
          "  pm.collectionVariables.set('petId', petId);",
          "  pm.collectionVariables.set('orderId', orderId);",
          "  pm.collectionVariables.set('username', username);",
          "  pm.collectionVariables.set('password', 'abc123');",
          "  pm.collectionVariables.set('petName', `pi-pet-${runId}`);",
          "  pm.collectionVariables.set('petUpdatedName', `pi-pet-updated-${runId}`);",
          "  pm.collectionVariables.set('petFinalName', `pi-pet-final-${runId}`);",
          "  pm.collectionVariables.set('userFirstName', 'QA');",
          "  pm.collectionVariables.set('userUpdatedFirstName', 'QA2');",
          "  pm.collectionVariables.set('userEmail', `qa_${runId}@example.com`);",
          "  pm.collectionVariables.set('userUpdatedEmail', `qa2_${runId}@example.com`);",
          "  pm.collectionVariables.set('runInitialized', 'true');",
          "}"
        ]
      }
    }
